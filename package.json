{
  "name": "dsh-tavern-pure-writer",
  "version": "0.2.4",
  "description": "白手套 Agent 调用工具，通过 inject() 将查到的自然语言资料交给前台 Agent。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "compatibility": { "tavernApiVersion": 8 }
  },
  "license": "MIT"
}
