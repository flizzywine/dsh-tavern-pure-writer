diff --git a/tavern-plugin/lib/domain/writing-material-text.js b/tavern-plugin/lib/domain/writing-material-text.js
new file mode 100644
index 000000000..19cdc7d9a
--- /dev/null
+++ b/tavern-plugin/lib/domain/writing-material-text.js
@@ -0,0 +1,67 @@
+import { marked } from 'marked'
+import { stripWritingSystemReminders } from './writing-system-reminders.js'
+
+const FRONT_MATTER = /^(?:\uFEFF)?---[ \t]*\r?\n(?:[^\r\n]*\r?\n)*?---[ \t]*(?:\r?\n|$)/
+const PROSE_FENCE = /^(?:text|txt|plain|plaintext|md|markdown)$/i
+const TERMINAL_LINE = /^(?:\$\s+|PS\s+[^>]*>\s*|[\w.-]+@[\w.-]+[^$]*\$\s+|(?:命令行|终端命令|command)\s*[:：]|(?:git|npm|npx|pnpm|yarn|curl|bash|zsh|powershell|node|python3?|mkdir|cd)\s+\S|(?:ls|rm|cat|cp|mv|grep|rg|find|echo|open|brew)\s+[-~./\\]|(?:ls|pwd|whoami)$)/i
+const QUOTED_PATH = /(["'])(?:[a-z]:[/\\]|~[/\\]|\.{1,2}[/\\]|\/)[^"'<>]+\1/gi
+const PATH = /(?<![\p{L}\p{N}_.:/\\])(?:[a-z]:[/\\]|~[/\\]|\.{1,2}[/\\]|\/(?=[\p{L}\p{N}_.-])|(?:references|scripts|config|resources|node_modules)[/\\])[^\s"'`<>()[\]{}，。！？；、：]+/giu
+const FILE_NAME = /(?<![\p{L}\p{N}_.:/\\])(?:[\p{L}\p{N}_.-]+[/\\])*[\p{L}\p{N}_.-]+\.(?:jsonl?|ya?ml|toml|ini|conf|env|log|md|mjs|cjs|jsx?|tsx?|py|sh|ps1|bat|cmd|html|css|txt)\b/giu
+const PATH_LABEL = /^(?:目录|路径|文件路径|文件目录|参考文件|配置文件|file(?: path)?|directory)\s*[:：]/i
+
+function withoutJson(text) {
+  const starts = /\{(?=\s*["}])|\[(?=\s*(?:["{\[\d\-\]]|(?:true|false|null)\b))/g
+  const tokens = /"(?:[^"\\]|\\[\s\S])*"|[{}[\]]/g
+  let output = '', copiedTo = 0
+  for (let start; (start = starts.exec(text));) {
+    let depth = 1, token
+    tokens.lastIndex = starts.lastIndex
+    while (depth && (token = tokens.exec(text))) {
+      if (token[0] === '{' || token[0] === '[') depth++
+      if (token[0] === '}' || token[0] === ']') depth--
+    }
+    if (depth) break
+    const end = tokens.lastIndex
+    starts.lastIndex = end
+    try { JSON.parse(text.slice(start.index, end)) } catch { continue }
+    output += text.slice(copiedTo, start.index)
+    copiedTo = end
+  }
+  return output + text.slice(copiedTo)
+}
+
+function inlineText(tokens) {
+  return tokens.map(token => {
+    if (token.type === 'html' || token.type === 'image') return ''
+    if (token.type === 'codespan' && TERMINAL_LINE.test(token.text.trim())) return ''
+    if (token.type === 'br') return '\n'
+    return token.tokens ? inlineText(token.tokens) : token.text ?? token.raw
+  }).join('')
+}
+
+function proseBlocks(tokens) {
+  return tokens.map(token => {
+    if (token.type === 'code') return PROSE_FENCE.test(token.lang) ? token.text + '\n' : ''
+    if (token.type === 'def' || token.type === 'hr') return ''
+    if (token.type === 'space') return '\n'
+    if (token.type === 'blockquote') return proseBlocks(token.tokens)
+    if (token.type === 'list') return token.items.map(item => proseBlocks(item.tokens)).join('')
+    if (token.type === 'table') return [token.header, ...token.rows]
+      .map(row => row.map(cell => inlineText(cell.tokens)).join('　')).join('\n') + '\n'
+    return (token.tokens ? inlineText(token.tokens) : token.text ?? token.raw) + '\n'
+  }).join('')
+}
+
+export function writingMaterialText(value) {
+  const text = stripWritingSystemReminders(String(value ?? '')).trimStart()
+  const source = text.replace(FRONT_MATTER, '')
+    .replace(/<!--[^]*?-->|<(script|style)\b[^>]*>[^]*?<\/\1\s*>/gi, '')
+  const prose = withoutJson(proseBlocks(marked.lexer(source)))
+  return prose.split(/\r?\n/).map(line => {
+    const text = line.trim()
+    if (TERMINAL_LINE.test(text) || /^[├└│]/.test(text)) return ''
+    const clean = text.replace(/<\/?[a-z][\w:-]*(?:\s[^<>]*)?\s*\/?>/gi, '')
+      .replace(QUOTED_PATH, '').replace(PATH, '').replace(FILE_NAME, '').trim()
+    return PATH_LABEL.test(text) && clean !== text ? '' : clean
+  }).join('\n').replace(/\n{3,}/g, '\n\n').trim()
+}
diff --git a/tavern-plugin/lib/domain/writing-preparation-sources.js b/tavern-plugin/lib/domain/writing-preparation-sources.js
new file mode 100644
index 000000000..2a9decb03
--- /dev/null
+++ b/tavern-plugin/lib/domain/writing-preparation-sources.js
@@ -0,0 +1,110 @@
+import { lastRoundVariableValues } from './foreground-variable-changes.js'
+import { canonicalTavernSkillName } from './tavern-skills.js'
+import { classifyWorldbookEntry } from './worldbook-entry-classification.js'
+import { isMvuUpdateEntry } from './worldbook-recall.js'
+import { writingMaterialText } from './writing-material-text.js'
+
+const BROWSE_LIMIT = 6
+
+const normalize = value => String(value ?? '').toLocaleLowerCase()
+const wordsOf = query => normalize(query).match(/[\p{L}\p{N}_-]+/gu) || []
+
+const publicVariable = name => !/^(?:\$|__|constructor$|prototype$)/.test(name)
+
+function describeVariable(names, value) {
+  if (!names.every(publicVariable)) return []
+  const labels = names.map(writingMaterialText)
+  return labels.every(Boolean) ? variableSentences(labels.join('的'), value) : []
+}
+
+function variableSentences(label, value) {
+  if (value === undefined) return [label + '已移除。']
+  if (value === null) return [label + '暂无记录。']
+  if (Array.isArray(value)) {
+    if (!value.length) return [label + '目前没有内容。']
+    return value.flatMap((item, index) => variableSentences(label + '的第 ' + (index + 1) + ' 项', item))
+  }
+  if (typeof value === 'object') return Object.entries(value).flatMap(([key, item]) => {
+    const name = publicVariable(key) && writingMaterialText(key)
+    return name ? variableSentences(label + '的' + name, item) : []
+  })
+  const text = typeof value === 'boolean' ? (value ? '是' : '否') : writingMaterialText(value)
+  return text ? [label + '为 ' + text + (/[。！？.!?]$/.test(text) ? '' : '。')] : []
+}
+
+function ranked(rows, query, fields) {
+  const words = wordsOf(query)
+  if (!words.length) return rows.slice(0, BROWSE_LIMIT)
+  return rows.map(row => {
+    const [title, text] = fields(row).map(normalize)
+    return { row, score: words.reduce((score, word) => score + (title.includes(word) ? 4 : 0) + (text.includes(word) ? 1 : 0), 0) }
+  }).filter(item => item.score > 0).sort((left, right) => right.score - left.score)
+    .slice(0, BROWSE_LIMIT).map(item => item.row)
+}
+
+export function createWritingPreparationSources({ tavernSkills, chatForSession, worldbookForChat, historyRecall }) {
+  return ({ gameId, frame, chat, signal }) => {
+    let catalog, history, worldbook
+    const disabled = new Set((chat?.disabledWritingSkills || []).map(canonicalTavernSkillName))
+    const applicableSkills = () => catalog ??= tavernSkills.list().then(rows => rows.filter(skill =>
+      skill.modelInvocable && skill.agents.includes('foreground') && !disabled.has(skill.name)))
+    const readHistory = () => history ??= chatForSession(gameId).then(current => {
+      if (!current) throw new Error('找不到本局写作上下文')
+      const target = current.regenRecovery?.candidateFrame && current.regenRecovery
+      const cutoff = target ? current.messages.findIndex(row => row?.role === 'assistant' &&
+        (target.targetMessageUid ? row.messageUid === target.targetMessageUid : Number(row.turn) === Number(target.storyTurn))) : -1
+      const rows = cutoff < 0 ? current.messages : current.messages.slice(0, cutoff)
+      const settled = rows.findLastIndex(row => row?.role === 'assistant' && String(row.text ?? '').trim())
+      return { ...current, messages: rows.slice(0, settled + 1) }
+    })
+    const context = frame.source?.regenerationMaterials
+    const memoryScope = {}
+    return {
+      listSkills: async () => {
+        signal.throwIfAborted()
+        return (await applicableSkills()).map(({ name, description }) => ({ name, description })).slice(0, 100)
+      },
+      skill: async ({ name, reference }) => {
+        const skill = (await applicableSkills()).find(row => row.name === name)
+        if (!skill) throw new Error('当前写作 Skill 不可用')
+        const text = reference ? await tavernSkills.readReference(name, reference) : skill.content
+        return [{ text }]
+      },
+      worldbook: async ({ query }) => {
+        if (!wordsOf(query).length) throw new Error('世界书检索需要当前场景的关键词')
+        worldbook ??= readHistory().then(worldbookForChat)
+        const rendered = new Map((context?.worldbookEntries || []).map(row => [row.ref, row.text]))
+        const rows = ((await worldbook)?.view?.entries || []).flatMap(entry => {
+          if (entry.enabled === false || isMvuUpdateEntry(entry)) return []
+          const text = rendered.get(entry.ref) ?? (classifyWorldbookEntry(entry).dynamic ? '' : entry.content)
+          return text?.trim() ? [{ id: entry.ref, title: entry.title || entry.comment, keys: [...(entry.keys || []), ...(entry.secondaryKeys || [])], text }] : []
+        })
+        return ranked(rows, query, row => [[row.title, ...row.keys].join(' '), row.text]).map(({ keys, ...row }) => row)
+      },
+      memory: async ({ query, turn }) => {
+        const saved = await readHistory()
+        const result = historyRecall.recall({ chat: saved, query: String(query ?? '').slice(0, 200), turn,
+          limit: 4, radius: 0, scope: memoryScope, audience: 'background' })
+        return [
+          ...result.matches.map(row => ({ id: row.turn + ':excerpt', title: '第 ' + row.turn + ' 轮', text: row.excerpt })),
+          ...result.rounds.map(row => ({ id: row.turn + ':full', title: '第 ' + row.turn + ' 轮', text: row.messages.map(message => message.text).join('\n') }))
+        ]
+      },
+      variables: async ({ query }) => {
+        const state = context?.generationState
+        const structured = state?.messageVariables?.stat_data || state?.variables?.stat_data || state?.variables
+        const variables = Object.entries(structured || {}).flatMap(([key, value]) => {
+          const lines = describeVariable([key], value)
+          return lines.length ? [{ title: key, text: lines.join('\n') }] : []
+        })
+        const posture = state?.posture
+        if (posture) variables.unshift({ id: 'posture', title: '角色情况', text: posture })
+        const current = await readHistory()
+        const changes = current.regenInProgress ? '' : lastRoundVariableValues(current)
+          .flatMap(({ names, value }) => describeVariable(names, value)).join('\n')
+        if (changes) variables.unshift({ id: 'changes', title: '上轮变量变化', text: changes })
+        return ranked(variables, query, row => [row.title, row.text])
+      }
+    }
+  }
+}
diff --git a/tavern-plugin/lib/domain/writing-preparation.js b/tavern-plugin/lib/domain/writing-preparation.js
new file mode 100644
index 000000000..26c632e66
--- /dev/null
+++ b/tavern-plugin/lib/domain/writing-preparation.js
@@ -0,0 +1,102 @@
+import { untilAborted } from './plugin-callback.js'
+import { writingMaterialText } from './writing-material-text.js'
+
+const SOURCE_LIMITS = {
+  skill: { read: 6000, label: '写作指引' },
+  worldbook: { read: 2800, label: '世界书' },
+  memory: { read: 1600, label: '剧情记忆' },
+  variables: { read: 5000, label: '当前变量' }
+}
+
+const TIMEOUT_MS = 120000
+const NO_MATERIAL = '没有查到资料。'
+
+export function createWritingPreparation({ allowed, runAgent, readSources }) {
+  const entries = new Map()
+
+  function register(owner, { prepare } = {}) {
+    if (typeof prepare !== 'function') throw new TypeError('writingPreparation 需要 prepare 函数')
+    if (entries.has(owner)) throw new Error('插件已注册白手套 Agent')
+    const entry = { owner, prepare, lifetime: new AbortController() }
+    entries.set(owner, entry)
+    return () => {
+      if (entries.get(owner) !== entry) return
+      entries.delete(owner)
+      entry.lifetime.abort(new Error('白手套 Agent 插件已停用'))
+    }
+  }
+
+  async function forGame(gameId) {
+    if (!entries.size) return null
+    const applicable = []
+    for (const entry of entries.values()) {
+      if (await allowed(entry.owner, gameId)) applicable.push(entry)
+    }
+    if (applicable.length > 1) throw new Error('本局有多个白手套 Agent 插件，请只启用一个')
+    return applicable[0] ?? null
+  }
+
+  async function prepare(entry, { gameId, frame, chat, context, signal }) {
+    const done = new AbortController()
+    const requestSignal = AbortSignal.any([done.signal, entry.lifetime.signal, AbortSignal.timeout(TIMEOUT_MS), ...(signal ? [signal] : [])])
+    const toolResults = []
+    let submitted
+    const sourceReaders = readSources({ gameId, frame, chat, signal: requestSignal })
+
+    async function read(kind, args) {
+      requestSignal.throwIfAborted()
+      if (submitted) throw new Error('本轮已提交 inject')
+      const limits = SOURCE_LIMITS[kind]
+      const rows = await sourceReaders[kind](args ?? {})
+      requestSignal.throwIfAborted()
+      const text = rows.slice(0, 8).flatMap(row => {
+        const text = writingMaterialText(row.text).slice(0, limits.read)
+        const title = writingMaterialText(row.title).slice(0, 120)
+        return text ? ['【' + limits.label + (title ? ' · ' + title : '') + '】\n' + text] : []
+      }).join('\n\n')
+      return text || NO_MATERIAL
+    }
+
+    function collectToolText() {
+      return untilAborted(Promise.all(toolResults), requestSignal).then(results =>
+        results.filter(result => result.ok && result.text !== NO_MATERIAL).map(result => result.text).join('\n\n'))
+    }
+
+    function inject(args = {}) {
+      requestSignal.throwIfAborted()
+      if (submitted) throw new Error('本轮已提交 inject')
+      if (!args || typeof args !== 'object' || Array.isArray(args) || Object.keys(args).length) throw new Error('inject 不接收参数')
+      submitted = collectToolText()
+      return submitted.then(() => ({ accepted: true }))
+    }
+
+    try {
+      requestSignal.throwIfAborted()
+      await untilAborted(Promise.resolve().then(() => entry.prepare({
+        gameId, turn: frame.turn, signal: requestSignal,
+        listSkills: () => {
+          requestSignal.throwIfAborted()
+          return sourceReaders.listSkills()
+        },
+        readSkill: args => read('skill', args),
+        findWorldbook: args => read('worldbook', args),
+        recallMemory: args => read('memory', args),
+        readVariables: args => read('variables', args),
+        inject,
+        runAgent: task => {
+          requestSignal.throwIfAborted()
+          return runAgent(entry.owner, { ...task, gameId, signal: requestSignal }, context, (name, result) => {
+            // Keep call order for concurrent tools and reuse the exact model-facing receipt.
+            if (!submitted && name !== 'inject') toolResults.push(result)
+          })
+        }
+      })), requestSignal)
+      requestSignal.throwIfAborted()
+      return await (submitted ?? collectToolText())
+    } finally {
+      done.abort()
+    }
+  }
+
+  return { register, forGame, prepare }
+}
diff --git a/tavern-plugin/lib/domain/writing-system-reminders.js b/tavern-plugin/lib/domain/writing-system-reminders.js
new file mode 100644
index 000000000..ccd19a695
--- /dev/null
+++ b/tavern-plugin/lib/domain/writing-system-reminders.js
@@ -0,0 +1,26 @@
+const HOST_REMINDERS = new Set(['runtime-context', 'skill-catalog', 'skill-invocation'])
+const REMINDER = /<system-reminder(?:\s[^>]*)?>[\s\S]*?(?:<\/system-reminder\s*>|$)/gi
+
+export function isWritingHostReminder(message) {
+  return message?.role === 'user' && HOST_REMINDERS.has(message.source?.kind)
+}
+
+export function stripWritingSystemReminders(text) {
+  return text.replace(REMINDER, '')
+}
+
+export function writingRequestMessages(messages) {
+  return messages.filter(message => !isWritingHostReminder(message)).flatMap(message => {
+    if (!Array.isArray(message?.content)) return [message]
