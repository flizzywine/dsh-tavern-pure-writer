@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { WRITING_PREPARATION_DESCRIPTOR } from '../tavern-plugin/lib/domain/background-descriptors.js'
+import { createMaintenanceHandlers } from '../tavern-plugin/lib/rpc/maintenance.js'
+
+test('writing trajectory policy also covers finished White Gloves after restart', async () => {
+  const reads = []
+  const query = {
+    async readSession(id) {
+      reads.push(id)
+      if (id === 'background-missing') throw new Error('not found')
+      const data = id === 'background-cold' ? WRITING_PREPARATION_DESCRIPTOR : { ...WRITING_PREPARATION_DESCRIPTOR, label: '普通插件任务' }
+      return { session: { origin: 'subagent' }, events: [{ type: 'subagent/descriptor', data }] }
+    }
+  }
+  const { getWritingTrajectoryPolicy: policy } = createMaintenanceHandlers({
+    str: value => String(value ?? ''),
+    ctx: { get: () => query },
+    backgroundAgentRunner: { requestContext: id => id === 'background-active' ? { writingPreparation: {} } : null },
+    chatHeaderForSession: id => id === 'card' ? { mode: 'card' } : { mode: 'story' },
+    pluginApi: { writingPreparation: { forGame: async id => id === 'game-enabled' ? {} : null } }
+  })
+  for (const sessionId of ['background-active', 'background-cold', 'game-enabled']) {
+    assert.deepEqual(await policy({ sessionId }), { hideSystemReminders: true })
+  }
+  for (const sessionId of ['background-unrelated', 'background-missing', 'game-disabled', 'card']) {
+    assert.deepEqual(await policy({ sessionId }), { hideSystemReminders: false })
+  }
+  assert.deepEqual(reads, ['background-cold', 'background-unrelated', 'background-missing'])
+})
