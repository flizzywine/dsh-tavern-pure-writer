new file mode 100644
index 000000000..d14e9a64b
--- /dev/null
+++ b/tavern-plugin/lib/domain/pure-writing-request.js
@@ -0,0 +1,61 @@
+import { inputKind } from './session-turn-input.js'
+import { promptSection } from './prompt-section.js'
+import { STORY_SUBMIT_TOOL_NAME } from './story-tool-submission.js'
+
+export const PURE_WRITING_REQUEST = 'pure-writing'
+
+const KEEP_FIXED_SECTIONS = new Set(['tavern:user-preference', 'tavern:character-card'])
+const STORY_SECTIONS = new Set(['base', 'card', 'card-instruction', 'script', 'guide'])
+const OUTPUT = '只写本轮的完整正文。可直接输出正文，或调用 submit_story 一次性提交完整正文。不要输出资料清单、工具过程或变量更新。'
+
+export function pureWritingTools(tools) {
+  return (tools || []).filter(tool => tool?.name === STORY_SUBMIT_TOOL_NAME)
+}
+
+export function pureWritingFixedSections(sections) {
+  return sections.filter(section => KEEP_FIXED_SECTIONS.has(section.name))
+}
+
+/** Copy only the actual transcript. Tool chains, old context and provider
+ * replay metadata are irrelevant once the writing request has its own prefix. */
+export function writingConversation(messages) {
+  return (messages || []).flatMap(message => {
+    if (message?.role === 'user') {
+      if (!inputKind(message)) return []
+      return message.content?.length ? [message] : []
+    }
+    if (message?.role !== 'assistant' || !(message.source?.kind === 'model' || !message.source)) return []
+    const content = (message.content || []).filter(block => block.type === 'text' && block.text?.trim())
+    if (!content.length) return []
+    const { id, role } = message
+    const source = message.source && { kind: 'model', provider: message.source.provider, model: message.source.model }
+    return [{ id, role, ...(source ? { source } : {}), content }]
+  })
+}
+
+export function pureWritingSystem(fixedSections, frame, back = []) {
+  const sections = fixedSections.map(section => section.text)
+  const cardSystem = frame.source?.card?.systemPromptText
+  if (cardSystem) sections.push(promptSection('card_system', cardSystem))
+  for (const item of frame.contributions) {
+    const source = item.source
+    if ((source.stage === 'context-plan' && STORY_SECTIONS.has(source.sectionKind)) || source.stage === 'runtime-preset') sections.push(item.text)
+  }
+  return [...sections, ...back.map(entry => entry.content), OUTPUT].filter(Boolean).join('\n\n')
+}
+
+export function projectPureWritingRequest(request, { system, material, frame }) {
+  const conversation = writingConversation(request.messages)
+  const inputAt = conversation.findLastIndex(message => message.role === 'user')
+  if (inputAt < 0) throw new Error('纯净写作找不到本轮玩家输入')
+  const messages = conversation.slice(Math.max(0, inputAt - 12), inputAt + 1)
+  if (material) messages.splice(messages.length - 1, 0, {
+    id: frame.frameId + ':inject',
+    role: 'user',
+    content: [{ type: 'text', text: promptSection('writing_material', material) }],
+    source: { kind: 'plugin:dsh-tavern-pure-writer', form: 'inject' }
+  })
+  // Existing host protocol choices refer to the tool list that was replaced.
+  const { toolChoice, ...base } = request
+  return { ...base, system, messages, tools: pureWritingTools(request.tools) }
+}
