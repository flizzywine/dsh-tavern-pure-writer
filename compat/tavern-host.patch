+
+const SOURCE_LIMITS = {
+  skill: { read: 6000, label: '写作 Skill' },
+  worldbook: { read: 2800, label: '世界书' },
+  memory: { read: 1600, label: '剧情记忆' },
+  variables: { read: 5000, label: '当前变量' }
+}
+
+const TIMEOUT_MS = 120000
+
+export function createWritingPreparation({ allowed, runAgent, readSources }) {
+  const entries = new Map()
+
+  function register(owner, { prepare } = {}) {
+    if (typeof prepare !== 'function') throw new TypeError('writingPreparation 需要 prepare 函数')
+    if (entries.has(owner)) throw new Error('插件已注册正文前置准备')
+    const entry = { owner, prepare, lifetime: new AbortController() }
+    entries.set(owner, entry)
+    return () => {
+      if (entries.get(owner) !== entry) return
+      entries.delete(owner)
+      entry.lifetime.abort(new Error('正文前置插件已停用'))
+    }
+  }
+
+  async function forGame(gameId) {
+    if (!entries.size) return null
+    const applicable = []
+    for (const entry of entries.values()) {
+      if (await allowed(entry.owner, gameId)) applicable.push(entry)
+    }
+    if (applicable.length > 1) throw new Error('本局有多个正文前置插件，请只启用一个')
+    return applicable[0] ?? null
+  }
+
+  async function prepare(entry, { gameId, frame, chat, messages, signal }) {
+    const done = new AbortController()
+    const requestSignal = AbortSignal.any([done.signal, entry.lifetime.signal, AbortSignal.timeout(TIMEOUT_MS), ...(signal ? [signal] : [])])
+    const reads = []
+    let submitted
+    const sourceReaders = readSources({ gameId, frame, chat, messages, signal: requestSignal })
+
+    function read(kind, args) {
+      requestSignal.throwIfAborted()
+      if (submitted) throw new Error('本轮已提交 inject')
+      const limits = SOURCE_LIMITS[kind]
+      const result = Promise.resolve().then(async () => {
+        requestSignal.throwIfAborted()
+        const rows = await sourceReaders[kind](args ?? {})
+        requestSignal.throwIfAborted()
+        return rows.slice(0, 8).flatMap(row => {
+          const text = String(row.text ?? '').trim().slice(0, limits.read)
+          const title = String(row.title ?? '').slice(0, 120)
+          return text ? ['【' + limits.label + (title ? ' · ' + title : '') + '】\n' + text] : []
+        }).join('\n\n').slice(0, MAX_TOOL_RESULT)
+      })
+      // Keep invocation order even if tools run in parallel. DSH also records
+      // each call, its arguments and its result in the preparation session.
+      reads.push(result)
+      return result.then(text => text || '没有查到资料。')
+    }
+
+    function inject(args = {}) {
+      requestSignal.throwIfAborted()
+      if (submitted) throw new Error('本轮已提交 inject')
+      if (!args || typeof args !== 'object' || Array.isArray(args) || Object.keys(args).length) throw new Error('inject 不接收参数')
+      submitted = untilAborted(Promise.allSettled(reads), requestSignal).then(results =>
+        results.flatMap(result => result.status === 'fulfilled' && result.value ? [result.value] : []).join('\n\n'))
+      return submitted.then(() => ({ accepted: true }))
+    }
+
+    try {
+      requestSignal.throwIfAborted()
+      const input = await untilAborted(Promise.resolve().then(sourceReaders.input), requestSignal)
+      await untilAborted(Promise.resolve().then(() => entry.prepare({
+        gameId, turn: frame.turn, ...input, signal: requestSignal,
+        listSkills: () => {
+          requestSignal.throwIfAborted()
+          return sourceReaders.listSkills()
+        },
+        readSkill: args => read('skill', args),
+        findWorldbook: args => read('worldbook', args),
+        recallMemory: args => read('memory', args),
+        readVariables: args => read('variables', args),
+        inject,
+        runAgent: task => {
+          requestSignal.throwIfAborted()
+          return runAgent(entry.owner, { ...task, gameId, signal: requestSignal })
+        }
+      })), requestSignal)
+      requestSignal.throwIfAborted()
+      if (!submitted) throw new Error('前置 Agent 没有调用 inject 提交正文上下文')
+      return await submitted
+    } finally {
+      done.abort()
+    }
+  }
+
+  return { register, forGame, prepare }
+}
